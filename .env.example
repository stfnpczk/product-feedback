# Pull real values with: pnpm dlx vercel env pull .env.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Optional, for opening `pnpm dev` on a phone: comma-separated LAN IPs, in .env.development.local
# DEV_ALLOWED_ORIGINS=

# For end-to-end tests, put a separate Neon branch URL in .env.test
# DATABASE_URL=
